# ---------------------------------------------------------------------------
# Copy to .env and fill in. `sl/config.py` loads this file at import time.
# ---------------------------------------------------------------------------

# Teacher sampling, judging, and OpenAI-backed evaluation.
OPENAI_API_KEY=...

# Optional: only needed if you route requests through OpenRouter.
OPENROUTER_API_KEY=...

# --- Open-model experiments -------------------------------------------------

# Read/write token from https://huggingface.co/settings/tokens.
# Needs write access if you push generated datasets or trained adapters.
HF_TOKEN=...

# HuggingFace account or org that generated datasets and models are pushed to.
HF_USER_ID=...

# --- vLLM (evaluation) ------------------------------------------------------

VLLM_LOGGING_LEVEL=INFO
VLLM_N_GPUS=1

# Must be >= the --lora-rank used during training (default: 64), or vLLM will
# refuse to load the adapter at evaluation time.
VLLM_MAX_LORA_RANK=64

VLLM_MAX_NUM_SEQS=512
